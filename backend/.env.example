# Copy to .env and adjust. All values are optional.

# PostgreSQL connection string. Default: postgresql://vrcm:vrcm@localhost:5432/vrcm
DATABASE_URL=postgresql://vrcm:vrcm@localhost:5432/vrcm

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Insert demo properties and bookings when the database is empty.
SEED_DEMO_DATA=true
